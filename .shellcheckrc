# The release scripts under scripts/release/ and scripts/sync-dev-after-release.sh
# are verbatim copies from the github-repo-setup skill, refreshed by copy and
# never edited here. CI and scripts/hooks run at --severity=style, so the
# info-level findings those copies carry are settled here instead.
external-sources=true
source-path=SCRIPTDIR
# SC1003: escaped backslash inside a case pattern (guarded-paths.sh).
# SC2016: literal backticks in printf format strings (sync-dev-after-release.sh).
# SC2317: return-or-exit guard in a sourced library (_lib.sh).
disable=SC1003,SC2016,SC2317
